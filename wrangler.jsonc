{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "event-ui-demo",
  "account_id": "28eaf05b15feca31806afc94e63daeba",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "ui.wtw.quest", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
